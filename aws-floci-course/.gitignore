# ============================================================
#  aws-floci-course/.gitignore
#  Written BEFORE any secret existed. Keep it that way.
# ============================================================

# ---- Command output and SECRETS ----
outputs/*
!outputs/.gitkeep

# ---- Generated Compose configuration ----
.env
.env.local

# ---- Emulator state ----
floci-data/
data/
.floci/

# ---- Credentials of every shape ----
*.pem
*.key
*-access-key.json
*credentials*

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ---- Python bytecode (Lab 10: py_compile leaves __pycache__ next to the handler) ----
__pycache__/
*.pyc

# ---- Lab 11: build output of the local buildspec runner ----
labs/lab-11-cicd/app/dist/
