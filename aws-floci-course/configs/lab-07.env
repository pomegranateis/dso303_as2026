# Lab 07 - EKS cluster, node group and microservices
# Generated on 2026-10-13T02:45:03Z
# Contains IDs, ARNs and names only. NO SECRETS. Safe to commit.
# The kubeconfig is NOT recorded here. It lives in ~/.kube/usms-lab07, outside this repo:
#   export KUBECONFIG=~/.kube/usms-lab07
# (a separate file, so the default kubectl context of another module is not changed).
# _lb_ports_ is 8081,8083, not the lab's 8081,8082: host port 8082 was already in use.
export USMS_EKS_CLUSTER=usms-eks-cluster
export USMS_EKS_NODEGROUP=usms-eks-nodes
export USMS_EKS_NAMESPACE=usms
export USMS_EKS_CLUSTER_ARN=arn:aws:eks:us-east-1:000000000000:cluster/usms-eks-cluster
export USMS_EKS_CLUSTER_STATUS=ACTIVE
export USMS_EKS_VERSION=1.30
# Updated 2026-10-22 (Lab 09 Step 18 rebuild): Floci gave the recreated cluster a new host port.
export USMS_EKS_ENDPOINT=https://localhost:6502
export USMS_EKS_LB_PORTS=8081,8083
export USMS_EKS_CLUSTER_ROLE_ARN=arn:aws:iam::000000000000:role/usms-eks-cluster-role
export USMS_EKS_NODE_ROLE_ARN=arn:aws:iam::000000000000:role/usms-eks-node-role
export USMS_POLICY_EKS_CLUSTER=arn:aws:iam::000000000000:policy/USMSEKSClusterPolicy
export USMS_POLICY_EKS_NODE=arn:aws:iam::000000000000:policy/USMSEKSNodePolicy
export USMS_EKS_CLUSTER_SG=sg-77d25192a5b480a71
export USMS_K8S_DEPLOY_GATEWAY=usms-gateway
export USMS_K8S_DEPLOY_ENROLMENT=usms-enrolment
export USMS_K8S_DEPLOY_RESULTS=usms-results
export USMS_K8S_SVC_GATEWAY=usms-gateway
export USMS_K8S_SVC_ENROLMENT=usms-enrolment
export USMS_K8S_SVC_RESULTS=usms-results
export USMS_K8S_CPU_REQUEST=50m
export USMS_K8S_MANIFEST_DIR=manifests/lab-07
