# Lab 08 - EKS scaling and service exposure
# Generated on 2026-10-19T05:10:13Z
# Contains names, ports and numbers only. NO SECRETS. Safe to commit.
# kubectl uses ~/.kube/usms-lab07 (export KUBECONFIG=~/.kube/usms-lab07), as in Lab 07.
# USMS_INGRESS_CLASS is empty: this k3s build runs no ingress controller (Step 16).
# USMS_NODEGROUP_* read 2/4/2: update-nodegroup-config is not implemented on Floci 1.5.34 (Step 10).
# USMS_SVC_GATEWAY_NODEPORT is auto-allocated and changes on every rebuild; 30080 is pinned.

export USMS_HPA_NAME=usms-enrolment-hpa
export USMS_HPA_MIN=2
export USMS_HPA_MAX=8
export USMS_HPA_CPU_TARGET=50
export USMS_HPA_SCALEDOWN_WINDOW=300

export USMS_PDB_GATEWAY=usms-gateway-pdb
export USMS_PDB_ENROLMENT=usms-enrolment-pdb

export USMS_SVC_NODEPORT_NAME=usms-results-np
export USMS_SVC_NODEPORT=30080
export USMS_SVC_GATEWAY_TYPE=LoadBalancer
export USMS_SVC_GATEWAY_NODEPORT=32473

export USMS_INGRESS_NAME=usms-portal-ingress
export USMS_INGRESS_CLASS=

export USMS_NODEGROUP_MIN=2
export USMS_NODEGROUP_MAX=4
export USMS_NODEGROUP_DESIRED=2

export USMS_NODE_LABEL_SELECTOR=workload=usms
export USMS_LOADGEN_DEPLOY=usms-loadgen
export USMS_K8S_MANIFEST_DIR_05B=manifests/lab-08
