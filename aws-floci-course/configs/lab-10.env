# Lab 10 - Edge functions with AWS Lambda
# Generated on 2026-11-06T03:43:19Z
# Contains names, ARNs and IDs only. NO SECRETS. Safe to commit.
# CloudFront: create-distribution works on Floci 1.5.34, but the stored record has no
# Lambda associations (Quantity 0); templates/lab-10-distribution-config.json is the
# validated source of truth for them.

# --- origin ---------------------------------------------------------------
export USMS_BUCKET_ARN=arn:aws:s3:::usms-student-data

# --- edge function 1: viewer-request --------------------------------------
export USMS_EDGE_VIEWER_FN=usms-edge-viewer-request
export USMS_EDGE_VIEWER_FN_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-edge-viewer-request
export USMS_EDGE_VIEWER_VERSION=2
export USMS_EDGE_VIEWER_VERSION_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-edge-viewer-request:2

# --- edge function 2: origin-response -------------------------------------
export USMS_EDGE_ORIGIN_FN=usms-edge-origin-response
export USMS_EDGE_ORIGIN_FN_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-edge-origin-response
export USMS_EDGE_ORIGIN_VERSION=3
export USMS_EDGE_ORIGIN_VERSION_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-edge-origin-response:3

export USMS_EDGE_RUNTIME=nodejs20.x
# Lab 10 Exercise 2: the edge functions now run as usms-edge-exec-role (logs only).
export USMS_EDGE_ROLE_ARN=arn:aws:iam::000000000000:role/usms-edge-exec-role
export USMS_EDGE_TRACE_FILE=outputs/lab-10-edge-trace.json

# --- regional function: transcript notifier -------------------------------
export USMS_LAMBDA_NOTIFIER_FN=usms-transcript-notifier
export USMS_LAMBDA_NOTIFIER_FN_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-transcript-notifier
export USMS_LAMBDA_NOTIFIER_RUNTIME=python3.12
export USMS_LAMBDA_NOTIFIER_ALIAS=live
export USMS_LAMBDA_NOTIFIER_ALIAS_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-transcript-notifier:live
export USMS_LAMBDA_NOTIFIER_VERSION=1
export USMS_LOG_GROUP_NOTIFIER=/aws/lambda/usms-transcript-notifier

# --- s3 notification ------------------------------------------------------
export USMS_NOTIFICATION_ID=usms-transcript-upload
export USMS_NOTIFICATION_PREFIX=transcripts/
export USMS_NOTIFICATION_SUFFIX=.json

# --- cloudfront (may be unsupported on this build) ------------------------
export USMS_CLOUDFRONT_SUPPORTED=yes
# list-distributions returns an XML root of <ListDistributionsResult> instead of <DistributionList>
# on Floci 1.5.34, so the CLI parses it to nothing (exit 0, no items). These two values come from
# the create-distribution response and were confirmed with get-distribution.
export USMS_CLOUDFRONT_DIST_ID=E1OWPB9TTQNP7G
export USMS_CLOUDFRONT_DOMAIN=E1OWPB9TTQNP7G.cloudfront.net
