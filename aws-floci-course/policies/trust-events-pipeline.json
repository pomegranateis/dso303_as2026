{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventBridgeAssumesThisRoleForTheSourceRuleOnly",
      "Effect": "Allow",
      "Principal": { "Service": "events.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "000000000000" },
        "ArnEquals": { "aws:SourceArn": "arn:aws:events:us-east-1:000000000000:rule/usms-enrolment-source-changed" }
      }
    }
  ]
}
