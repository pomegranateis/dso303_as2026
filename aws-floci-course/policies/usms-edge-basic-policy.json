{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LogsForDirectInvocationsInTheHomeRegion",
      "Effect": "Allow",
      "Action": [ "logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents" ],
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/usms-edge-*",
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/usms-edge-*:*"
      ]
    },
    {
      "Sid": "LogsForEdgeReplicasInWhicheverRegionServesTheViewer",
      "Effect": "Allow",
      "Action": [ "logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents" ],
      "Resource": [
        "arn:aws:logs:*:000000000000:log-group:/aws/lambda/us-east-1.usms-edge-*",
        "arn:aws:logs:*:000000000000:log-group:/aws/lambda/us-east-1.usms-edge-*:*"
      ]
    }
  ]
}
